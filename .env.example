PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
# Public HTTPS origin, without a trailing slash. Leave blank for localhost development.
PUBLIC_ORIGIN=
COOKIE_SECURE=false
# Replace the exposed key in Google AI Studio and put the NEW key here only.
GEMINI_API_KEY=
# Optional explicit text model. Leave blank to select from the discovered catalog.
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
# Optional image and realtime audio overrides. Keep keys on the server only.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
# TURN is required for reliable calls across mobile networks. Use a coturn shared secret.
TURN_URL=
TURN_SECRET=
