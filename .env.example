PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
# Public HTTPS origin, without a trailing slash. Leave blank for localhost development.
PUBLIC_ORIGIN=
COOKIE_SECURE=false
# Replace the exposed key in Google AI Studio and put the NEW key here only.
GEMINI_API_KEY=
# Optional explicit text model. Leave blank to select from the discovered catalog.
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
# Optional image and realtime audio overrides. Keep keys on the server only.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
# TURN is required for reliable calls across mobile networks. Use a coturn shared secret.
TURN_URL=
TURN_SECRET=
# Admin account (created/updated on server start). Put real values ONLY in .env or server/.env (both gitignored).
# Password must be at least 8 characters. Never commit it.
ADMIN_HANDLE=
ADMIN_PASSWORD=
# ComfyUI Studio + optional user profile video generation (rendered on the configured ComfyUI).
COMFYUI_URL=http://127.0.0.1:8188
# Folder holding API-format workflow JSON, e.g. video_fasth3_ominiref_r2v.json (optional, enables video).
COMFYUI_WORKFLOW_DIR=
# Optional direct path to the owner's personal MiniMax H3 reference-to-video API workflow.
COMFYUI_VIDEO_WORKFLOW_FILE=
COMFY_RATE=10

# Permanent server origin (named Cloudflare Tunnel). Apps try this first, then server.json.
PRIMARY_ORIGIN=https://api.purefxai.store
